    {
      "id": "my-yes-no",
      "language": "my",
      "concept": "yes_no_ka",
      "content": {
        "version": 1,
        "language": "my",
        "script": "Myanmar",
        "reviewStatus": "draft",
        "register": {
          "en": "Plain spoken forms for a familiar conversation; this is not a full lesson on polite address.",
          "mr": "ओळखीच्या व्यक्तीशी बोलताना वापरण्याची साधी रूपे; आदरार्थी संबोधनाचा हा संपूर्ण धडा नाही."
        },
        "sense": {
          "en": "An offer of coffee, the listener’s affirmative plan, and a question about a male addressee’s student status.",
          "mr": "कॉफी देऊ करणारा प्रश्न, ऐकणाऱ्याचे होकारार्थी उत्तर आणि समोरचा पुरुष विद्यार्थी आहे का याबद्दलचा प्रश्न."
        },
        "provenance": {
          "en": "The two questions reuse the bundled yes/no lesson. The coffee reply, situations and bilingual guidance are authored drafts informed by the linked grammar references.",
          "mr": "दोन्ही प्रश्न अॅपमधील हो/नाही प्रश्नांच्या धड्यातून घेतले आहेत. कॉफीबद्दलचे उत्तर, प्रसंग आणि दोन्ही भाषांतील मार्गदर्शन हे दिलेल्या व्याकरण संदर्भांच्या आधारे तयार केलेले मसुदे आहेत."
        },
        "sourceRevision": "e329e2d1f0eb14f0fe90332d2e7c2700ed3f1ab2",
        "exampleRefs": [
          {
            "conceptId": "yes_no_ka",
            "language": "my",
            "index": 2,
            "text": "ကော်ဖီ သောက်မလား။"
          },
          {
            "conceptId": "yes_no_ka",
            "language": "my",
            "index": 1,
            "text": "ကျောင်းသားလား။"
          }
        ]
      },
