    {
      "id": "my-negation",
      "language": "my",
      "concept": "negation",
      "content": {
        "version": 1,
        "language": "my",
        "script": "Myanmar",
        "reviewStatus": "draft",
        "register": {
          "en": "Plain spoken statements and a direct request; politeness depends on the situation.",
          "mr": "साधी बोलचालीतील विधाने आणि थेट विनंती; नम्रता परिस्थितीवर अवलंबून असते."
        },
        "sense": {
          "en": "A decision about a future outing, a contrasting request, and an eating habit.",
          "mr": "उद्याच्या सहलीबद्दलचा निर्णय, त्याहून वेगळी विनंती आणि खाण्याची सवय."
        },
        "provenance": {
          "en": "The two negative statements reuse the bundled negation lesson. The request contrast, prompts and Marathi guidance are authored drafts informed by the linked grammar references.",
          "mr": "दोन नकारार्थी विधाने अॅपमधील नकाराच्या धड्यातून घेतली आहेत. विनंतीशी तुलना, प्रश्न आणि मराठी मार्गदर्शन हे दिलेल्या व्याकरण संदर्भांच्या आधारे तयार केलेले मसुदे आहेत."
        },
        "sourceRevision": "262c47cc18d1f0c98fabeea980bf2e65b5700eb3",
        "exampleRefs": [
          {
            "conceptId": "negation",
            "language": "my",
            "index": 2,
            "text": "မသွားဘူး။"
          },
          {
            "conceptId": "negation",
            "language": "my",
            "index": 1,
            "text": "အသား မစားဘူး။"
          }
        ]
      },
      "sources": [
        {
          "label": "Bundled negation examples (draft, pinned source)",
          "url": "https://github.com/Celeritas7/Catalyst/blob/262c47cc18d1f0c98fabeea980bf2e65b5700eb3/data/grammar.yaml"
        },
        {
          "label": "NIU SEAsite: negative statements",
          "url": "https://seasite.niu.edu/Burmese/Beginning/Blesson_5/syntax.htm"
        },
        {
          "label": "NIU SEAsite: negative requests",
          "url": "https://seasite.niu.edu/Burmese/Beginning/Blesson_2/syntax.htm"
        },
        {
